Plot(){
  Options(){ MCMC_Iterations=100000; Convergence=95; };
  Outlier_Model("General",T(5),U(0,4),"t");
  Outlier_Model("Charcoal",Exp(1,-10,0),U(0,3),"t");
  Sequence(){
    Boundary("MidStart_Duero_basins"){
      Transition("Duration_Start_Duero_basins");
      Start("Onset_Duero_basins");
      End("Peak_Duero_basins");
    };
    Phase("Duero_basins"){
      R_Date("Sac-1514",5970,60){Outlier("Charcoal",1);};
      R_Date("GrA-9573",4160,50){Outlier("Charcoal",1);};
      R_Date("Hv-1783",4590,65){Outlier("Charcoal",1);};
      R_Date("CSIC-716",5050,70){Outlier("Charcoal",1);};
      R_Date("GrN-4924",5060,50){Outlier("Charcoal",1);};
      R_Date("GrN-5734",4900,40){Outlier("Charcoal",1);};
      R_Date("CSIC-1328",5124,30){Outlier("Charcoal",1);};
    };
    Boundary("MidEnd_Duero_basins"){
      Start("Decline_Duero_basins");
      Transition("Duration_End_Duero_basins");
      End("Disappear_Duero_basins");
    };
  };
};
