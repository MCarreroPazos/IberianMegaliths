Plot(){
  Options(){ MCMC_Iterations=100000; Convergence=95; };
  Outlier_Model("",N(0,2),0,"s");
  Sequence(){
    Boundary("MidStart_South"){
      Transition("Duration_Start_South");
      Start("Onset_South");
      End("Peak_South");
    };
    Phase("South"){
      R_Date("CSIC-81_C",4290,92){Outlier(0.05);};
      R_Date("KN-72",4380,120){Outlier(0.05);};
      R_Date("Beta-233951",4480,40){Outlier(0.05);};
      R_Date("Beta-153911",4410,60){Outlier(0.05);};
    };
    Boundary("MidEnd_South"){
      Start("Decline_South");
      Transition("Duration_End_South");
      End("Disappear_South");
    };
  };
};
