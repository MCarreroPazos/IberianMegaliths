Plot(){
  Options(){ MCMC_Iterations=100000; Convergence=95; };
  Outlier_Model("General",T(5),U(0,4),"t");
  Outlier_Model("Charcoal",Exp(1,-10,0),U(0,3),"t");
  Sequence(){
    Boundary("MidStart_Ebro_basin"){
      Transition("Duration_Start_Ebro_basin");
      Start("Onset_Ebro_basin");
      End("Peak_Ebro_basin");
    };
    Phase("Ebro_basin"){
      R_Date("GrN-18671",4720,150){Outlier("Charcoal",1);};
      R_Date("GrN-12121",5290,40){Outlier("Charcoal",1);};
      R_Date("CSIC-952",4730,30){Outlier("Charcoal",1);};
      R_Date("GrN-18667",5170,100){Outlier("Charcoal",1);};
      R_Date("GrN-18669",5375,45){Outlier("Charcoal",1);};
      R_Date("Bln-5541",5000,38){Outlier("Charcoal",1);};
      R_Date("GrN-12994",5150,60){Outlier("Charcoal",1);};
      R_Date("N.R.2b",4330,110){Outlier("Charcoal",1);};
      R_Date("Grn-14128",5670,110){Outlier("Charcoal",1);};
      R_Date("GrN-18670",5240,65){Outlier("Charcoal",1);};
    };
    Boundary("MidEnd_Ebro_basin"){
      Start("Decline_Ebro_basin");
      Transition("Duration_End_Ebro_basin");
      End("Disappear_Ebro_basin");
    };
  };
};
