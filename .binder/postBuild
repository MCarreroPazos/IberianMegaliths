#!/bin/bash
set -e

# Make OxCal scripts executable if present
if [ -d "OxCal/bin" ]; then
  chmod +x OxCal/bin/* 2>/dev/null || true
fi

# Install Quarto CLI (v1.4.553)
if ! command -v quarto &> /dev/null; then
  echo "Installing Quarto CLI..."
  mkdir -p "$HOME/.local/bin"
  curl -sL "https://github.com/quarto-dev/quarto-cli/releases/download/v1.4.553/quarto-1.4.553-linux-amd64.tar.gz" | tar -zx -C "$HOME/.local" --strip-components=1
fi

